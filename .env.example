# ============================================================
# Variáveis de ambiente — copie este arquivo para ".env.local"
# e preencha com os valores reais do seu projeto Supabase.
#
# No Supabase: Project Settings > API
# ============================================================

# URL do projeto — botão "Connect" no topo, ou Settings > Data API
# (algo como https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave SECRETA do servidor — Settings > API Keys > seção "Secret keys"
# Nas contas novas (2026) começa com "sb_secret_..." (antes se chamava service_role).
# NUNCA exponha no navegador nem no Git.
SUPABASE_SERVICE_ROLE_KEY=

# Senha da área administrativa da lista de presença (/lista)
# Troque por uma senha só sua.
ADMIN_SENHA=vivi50
